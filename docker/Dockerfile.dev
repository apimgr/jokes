FROM casjaysdev/go:latest AS builder

ARG TARGETARCH
ARG VERSION=devel
ARG COMMIT_ID=unknown
ARG BUILD_EPOCH=0
ARG OFFICIAL_SITE=https://jokes.apimgr.us

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOFLAGS=-buildvcs=false go build -trimpath -ldflags "-X main.Version=${VERSION} -X main.CommitID=${COMMIT_ID} -X main.BuildEpoch=${BUILD_EPOCH} -X main.OfficialSite=${OFFICIAL_SITE}" -o /jokes ./src

FROM alpine:latest

RUN apk add --no-cache bash curl tini tor
RUN mkdir -p /config/jokes /data/jokes /data/db/sqlite /data/log/jokes /data/backups/jokes
COPY --from=builder /jokes /usr/local/bin/jokes
COPY docker/rootfs/ /
RUN chmod 755 /usr/local/bin/jokes /usr/local/bin/entrypoint.sh

ARG VERSION=devel
ENV MODE=development TZ=America/New_York
EXPOSE 80
STOPSIGNAL SIGRTMIN+3
HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 CMD /usr/local/bin/jokes --status || exit 1
ENTRYPOINT ["tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh"]
